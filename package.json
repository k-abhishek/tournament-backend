{
  "name": "tournament-backend",
  "version": "1.0.0",
  "description": "Gaming Tournament Platform - Backend API (Node.js + Fastify + Clerk)",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "worker": "node src/worker/index.js",
    "dev:worker": "nodemon --watch src --ext js src/worker/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.3.0",
    "pino-pretty": "^13.1.3",
    "svix": "^2.5.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.20.0"
  }
}
