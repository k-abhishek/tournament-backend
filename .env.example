# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tournament_db?schema=public"

# Redis (for BullMQ queues & caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Clerk ─────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret — set up at Clerk Dashboard → Webhooks → your endpoint
# Events to subscribe: user.created, user.updated, user.deleted,
#                      organizationMembership.created, organizationMembership.deleted
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Swagger docs
SWAGGER_ENABLED=true
